{
  "name": "react-boilerplate",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "start": "cross-env VITE_ENV=dev vite",
    "start:backend": "node mock-api/server.js",
    "typegen": "npx openapicmd typegen ./src/apis/api.yml > src/apis/api.d.ts && prettier --write ./src/apis/api.d.ts",
    "build": "yarn run typegen && tsc && eslint . && cross-env VITE_ENV=prod vite build",
    "preview": "vite preview",
    "test": "cross-env VITE_ENV=test vitest",
    "test:coverage": "cross-env VITE_ENV=test vitest run --coverage",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "format": "prettier --write .",
    "lint": "eslint .",
    "type-check": "tsc"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "@mui/x-date-pickers": "9.17.0",
    "@reduxjs/toolkit": "2.14.0",
    "ag-grid-community": "36.3.0",
    "ag-grid-react": "36.3.0",
    "axios": "1.21.0",
    "date-fns": "4.4.0",
    "formik": "2.4.9",
    "i18next": "27.0.1",
    "js-yaml": "5.5.0",
    "notistack": "3.0.2",
    "openapi-client-axios": "7.9.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.1",
    "react-redux": "9.3.1",
    "react-router-dom": "7.18.5",
    "yup": "1.7.1"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.28.8",
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "10.6.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "connect-api-mocker": "1.11.0",
    "cors": "2.8.6",
    "cross-env": "10.1.0",
    "cypress": "16.2.0",
    "eslint": "10.14.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.7",
    "express": "5.3.0",
    "jsdom": "31.0.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "dependenciesMeta": {
    "cypress": {
      "built": true
    }
  }
}
